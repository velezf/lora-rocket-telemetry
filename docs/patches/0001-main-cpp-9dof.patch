+static const imu::Axis LONG_AXIS = imu::Axis::Z;
+
 float readBatteryVoltage() {
   int raw = analogRead(A7);  // A7 reads battery via a 2:1 divider
   return raw * 3.3f / 1023.0f * 2.0f;
@@ -90,6 +107,27 @@ void setup() {
   groundPressure = sum / 50.0f;
 
