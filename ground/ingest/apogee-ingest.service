[Unit]
Description=Apogee ground telemetry ingest (single radio owner)
# Clock must be trustworthy before a session opens: apogee-rtc-restore sets it from the
# PiSugar RTC (offline/field); NTP refines at home. The ExecStartPre gate is FAIL-CLOSED,
# so DISABLE the start limit — the unit must be free to retry until the clock is trusted
# (NTP arrives, or the operator attests) without tripping start-limit lockout.
After=network-online.target time-sync.target pisugar-server.service apogee-rtc-restore.service
Wants=network-online.target time-sync.target
StartLimitIntervalSec=0
# Only one process may own the SPI radio — do not run rx_test.py etc. alongside.

[Service]
Type=simple
User=rocketman
WorkingDirectory=/home/rocketman/lora-rocket-telemetry
# Never open a session under a stale clock. FAIL-CLOSED gate: proceed only if the clock
# is NTP-synced OR set from the PiSugar RTC (the /run marker) — a plausible-year
# systemd-timesyncd floor alone no longer passes. Field escape hatch when the RTC is
# dead + no network: `python -m ground.clock.attest_clock`, then start this service.
ExecStartPre=/home/rocketman/gs-venv/bin/python -m ground.clock.gate
# gs-venv has all ground deps (luma.oled + pillow via pip; flask/spidev/lgpio via
# --system-site-packages). Using it keeps the OLED + dashboard + radio in one env.
ExecStart=/home/rocketman/gs-venv/bin/python -m ground.ingest.service
Restart=on-failure
RestartSec=3
# Clean shutdown: SIGTERM -> service writes service_stop + drains the log queue.
KillSignal=SIGTERM
TimeoutStopSec=6

[Install]
WantedBy=multi-user.target
